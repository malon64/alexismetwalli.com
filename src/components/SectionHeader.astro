---
interface Props {
  id?: string;
  number: string;
  title: string;
  intro?: string;
  inverted?: boolean;
}

const { id, number, title, intro, inverted = false } = Astro.props;
---

<header id={id} class:list={["section-header", { "section-header--inverted": inverted }]}>
  <p class="section-kicker">{number} / {title.toUpperCase()}</p>
  {intro && <p class="section-intro">{intro}</p>}
</header>
